# Copy this file to .env and fill in your values
BASE_URL=https://shop-abbamedix.sandbox.onample.com

# BrowserStack credentials (from browserstack.com > Settings)
BROWSERSTACK_USERNAME=your-username
BROWSERSTACK_ACCESS_KEY=your-access-key

# Test account 1 - primary test user
TEST_USER_EMAIL=your-test-email@example.com
TEST_USER_PASSWORD=your-test-password

# Test account 2 - secondary test user (for parallel sessions)
TEST_USER2_EMAIL=your-test-email2@example.com
TEST_USER2_PASSWORD=your-test-password2
